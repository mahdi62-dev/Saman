			</setting>
			<setting name="FontBehavior" serializeAs="String">
				<value></value>
			</setting>
			<setting name="DefaultAppFont" serializeAs="String">
				<value>IRANSansFaNum;9</value>
			</setting>
			<setting name="DPIAwarenessMode" serializeAs="String">
